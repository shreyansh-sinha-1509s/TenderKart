{
  "version": 2,
  "redirects": [
    {
      "source": "/analytics.html",
      "destination": "/"
    },
    {
      "source": "/analytics",
      "destination": "/"
    },
    {
      "source": "/manager.html",
      "destination": "/"
    },
    {
      "source": "/contact.html",
      "destination": "/"
    },
    {
      "source": "/applications.html",
      "destination": "/dashboard.html"
    },
    {
      "source": "/about-tenderkart",
      "destination": "/about-tenderkart.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
